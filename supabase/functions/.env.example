# Secrets for the send-sms Edge Function (Supabase Auth "Send SMS" hook).
#
#   cp supabase/functions/.env.example supabase/functions/.env   # fill it in
#   supabase secrets set --env-file supabase/functions/.env --project-ref <project-ref>
#
# These live in Supabase (Edge Functions → Secrets), not in the API's .env.
# The NIMBUS_* values are the same ones the AI try-on project uses.

# Authentication → Auth Hooks → Send SMS hook → Generate secret. Starts with "v1,whsec_".
SEND_SMS_HOOK_SECRET=

NIMBUS_USER_ID=
NIMBUS_PASSWORD=

# HairOriginals' DLT header, entity and OTP template (as registered on the DLT portal).
NIMBUS_SENDER_ID=HAIROG
NIMBUS_ENTITY_ID=1701165425595415105
NIMBUS_TEMPLATE_ID=1707178394111991016

# Must match the DLT-registered text exactly, with {otp} where the template has {#var#}.
# Changing the wording means registering a new DLT template and updating NIMBUS_TEMPLATE_ID too.
NIMBUS_OTP_TEMPLATE="Your HairOriginals-AiTryOn verification code is {otp}. Do not share it with anyone."
