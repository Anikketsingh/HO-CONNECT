# HO Connect: copy to .env and fill in. NEVER put real values in this file: it is committed to git.
# (.env is git-ignored; .env.example is not.)

# Supabase (Project Settings → Data API / API Keys)
SUPABASE_URL=https://your-project-ref.supabase.co
# Secret key (sb_secret_…), server only
SUPABASE_SERVICE_ROLE_KEY=
# Only for projects still on the legacy JWT secret. Leave EMPTY for new projects (JWKS is used).
SUPABASE_JWT_SECRET=
# Publishable key (sb_publishable_…), safe for the apps
SUPABASE_ANON_KEY=

# Connect → Session pooler (port 5432). Replace [YOUR-PASSWORD] including the brackets; URL-encode @ as %40.
DATABASE_URL=postgresql://postgres.your-project-ref:YOUR_PASSWORD@aws-0-ap-south-1.pooler.supabase.com:5432/postgres

# API
PORT=4000
CORS_ORIGINS=http://localhost:3000
# 32 random bytes, base64: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
DATA_ENCRYPTION_KEY=

# Customer consent SMS (sent by the API; partner login SMS goes through the Supabase hook instead).
#   console = development: codes are printed to the API log and shown in the app
#   nimbus  = real SMS: also set the DLT template on the consent_otp message template (see README)
OTP_PROVIDER=console
# Needed only when OTP_PROVIDER=nimbus. Same account as supabase/functions/.env.
NIMBUS_USER_ID=
NIMBUS_PASSWORD=
NIMBUS_SENDER_ID=HAIROG
NIMBUS_ENTITY_ID=

# Where customers open the QR / link page (the dashboard app serves /r/<partner code>). It must be reachable from their phones:
# on your own network use your computer's address (e.g. http://192.168.1.20:3000); in production use your public domain.
PUBLIC_WEB_URL=http://localhost:3000
# The AI try-on app. Partners' try-on QR codes open it with UTM tags (utm_source=ho_connect, utm_campaign=<partner code>),
# which the try-on app forwards to the DigiCuro CRM with the lead.
TRYON_WEB_URL=https://aitryon.hairoriginals.com
# Push notifications to partners: "expo" sends them, "console" only prints them in the API log.
PUSH_PROVIDER=expo
# Optional: Expo "enhanced push security" access token.
EXPO_ACCESS_TOKEN=

# Partner app (read by Expo when it starts)
# Create the project with `npx eas-cli init` inside apps/mobile; push tokens need it. Leave empty to turn push off.
EXPO_PUBLIC_EAS_PROJECT_ID=
